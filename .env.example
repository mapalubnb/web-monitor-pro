# ============================================================
# 飞书应用凭证（必填）
# ============================================================
# 获取方式：飞书开放平台 -> 创建企业自建应用 -> 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 应用加密配置（可留空，使用 WebSocket 长连接时不需要）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ============================================================
# 飞书目标会话（必填其一）
# ============================================================
# 推送目标群 chat_id（以 oc_ 开头）。通过 /sniff_chat 命令或 API 可获取
FEISHU_TARGET_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxx

# 管理员飞书 open_id（允许使用命令的用户，多个用逗号分隔）
FEISHU_ADMIN_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 运行参数
# ============================================================
# 默认检查间隔（秒）
DEFAULT_CHECK_INTERVAL=60

# 全局最大并发抓取数
MAX_CONCURRENT_FETCH=5

# 单域名最小间隔（秒）
DOMAIN_MIN_INTERVAL=10

# 请求超时（秒）
REQUEST_TIMEOUT=30

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================
# Playwright 渲染（纯 CSR 站点兜底，按需启动 Chromium）
# ============================================================
# 是否启用（true/false），启用后遇到纯 CSR 页面会自动启动 Chromium 渲染
ENABLE_PLAYWRIGHT=true

# 页面渲染超时（秒）
PLAYWRIGHT_TIMEOUT=30

# 每个浏览器实例最多处理 N 页后回收重启（防内存泄漏）
PLAYWRIGHT_MAX_PAGES=20

# ============================================================
# 可选：代理
# ============================================================
# 例：http://user:pass@host:port 或 socks5://host:port
HTTP_PROXY=
HTTPS_PROXY=

# ============================================================
# 可选：熔断与文件保留期
# ============================================================
# 连续失败 N 次触发熔断（自动禁用任务并告警），默认 20
CIRCUIT_BREAKER_THRESHOLD=20

# data/snapshots 目录孤儿文件保留天数（基准快照被引用时始终保留），默认 30
SNAPSHOT_RETENTION_DAYS=30

# /debug 产生的 task_N_debug.html 保留天数，默认 7
DEBUG_HTML_RETENTION_DAYS=7
