# ============================================================
# 飞书应用凭证（必填）
# ============================================================
# 获取方式：飞书开放平台 -> 创建企业自建应用 -> 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 应用加密配置（可留空，使用 WebSocket 长连接时不需要）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ============================================================
# 飞书目标会话（必填其一）
# ============================================================
# 推送目标群 chat_id（以 oc_ 开头）。通过 /sniff_chat 命令或 API 可获取
FEISHU_TARGET_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxx

# 管理员飞书 open_id（允许使用命令的用户，多个用逗号分隔）
FEISHU_ADMIN_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 运行参数
# ============================================================
# 默认检查间隔（秒）
DEFAULT_CHECK_INTERVAL=60

# 全局最大并发抓取数
MAX_CONCURRENT_FETCH=5

# 单域名最小间隔（秒）
DOMAIN_MIN_INTERVAL=10

# 请求超时（秒）
REQUEST_TIMEOUT=30

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================
# 可选：外部渲染 API（L5 级硬骨头网页的兜底）
# ============================================================
# Jina Reader 免费额度 1M 次/月，留空即不启用
JINA_READER_API_KEY=

# Firecrawl（可选，留空即不启用）
FIRECRAWL_API_KEY=

# ============================================================
# 可选：代理
# ============================================================
# 例：http://user:pass@host:port 或 socks5://host:port
HTTP_PROXY=
HTTPS_PROXY=
